<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Compliance Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>

  :root {
    --ink: #0A0B0E;
    --panel: #13151A;
    --line: #23262E;
    --text: #ECE8E1;
    --muted: #8F8C87;
    --champagne: #E4C9A0;
    --teal: #5CE1D6;
    --fail: #E07A6B;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--ink); color: var(--text); font: 15px/1.6 Inter, system-ui, sans-serif; }
  main { max-width: 1040px; margin: 0 auto; padding: 48px 16px; }
  .eyebrow { font: 500 12px 'IBM Plex Mono', monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--teal); }
  h1 { font-size: 32px; font-weight: 600; margin: 8px 0 4px; color: var(--champagne); }
  h2 { font-size: 20px; font-weight: 600; margin: 40px 0 12px; color: var(--champagne); }
  .meta { color: var(--muted); font: 12px 'IBM Plex Mono', monospace; }
  .stats { display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
  .stat { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; min-width: 110px; }
  .stat b { display: block; font-size: 24px; }
  .stat span { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
  .wrap { overflow-x: auto; }
  table { width: 100%; table-layout: fixed; border-collapse: collapse; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  th, td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; font-size: 14px; }
  th { color: var(--muted); font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
  .pill { font: 500 11px 'IBM Plex Mono', monospace; padding: 3px 8px; border-radius: 99px; text-transform: uppercase; border: 1px solid; display: inline-block; white-space: nowrap; margin: 2px 4px 2px 0; }
  .pass { color: var(--teal); }
  .fail { color: var(--fail); }
  .error { color: var(--champagne); }
  .controls { font: 12px 'IBM Plex Mono', monospace; color: var(--champagne); }
  .accepted { color: var(--champagne); }
  .exception { margin-top: 6px; color: var(--muted); font-size: 13px; }
  th:nth-child(1) { width: 170px; }
  th:nth-child(2) { width: 32%; }
  th:nth-child(3) { width: 160px; }
  .integrity { margin: 20px 0 8px; padding: 12px 16px; border: 1px solid var(--line); border-left: 4px solid var(--champagne); border-radius: 8px; background: var(--panel); font-size: 14px; }
  .integrity.verified { border-left-color: var(--teal); }
  .integrity.problems, .integrity.not-verified { border-left-color: var(--fail); }
  .integrity ul { margin: 6px 0 0; padding-left: 18px; }
  .fingerprint { margin-top: 6px; font: 12px 'IBM Plex Mono', monospace; color: var(--muted); word-break: break-all; }
</style>
</head>
<body>
<main>
  <div class="eyebrow">Continuous control monitoring</div>
  <h1>Compliance Dashboard</h1>
  <div class="meta">Collected {{ collected_at }} (UTC) · Source: {{ evidence_file }}</div>
    <div class="integrity {{ integrity_status | replace(' ', '-') }}">
    <b>Evidence integrity:</b>
    {% if integrity_status == "verified" %}
      verified against the append-only ledger; hash chain intact.
    {% elif integrity_status == "problems" %}
      problems found in the ledger.
      <ul>{% for p in problems %}<li>{{ p }}</li>{% endfor %}</ul>
    {% elif integrity_status == "unavailable" %}
      ledger not available; integrity not verified.
    {% else %}
      this evidence file is not recorded in the ledger.
    {% endif %}
    <div class="fingerprint">SHA-256: {{ fingerprint }}</div>
  </div>

  {% for repo, results in groups.items() %}
  <h2>{{ repo }}</h2>
  <div class="stats">
    <div class="stat"><b class="pass">{{ counts[repo]["pass"] }}</b><span>Pass</span></div>
    <div class="stat"><b class="fail">{{ counts[repo]["fail"] }}</b><span>Fail</span></div>
    <div class="stat"><b class="error">{{ counts[repo]["error"] }}</b><span>Error</span></div>
  </div>
  <div class="wrap">
    <table>
      <thead><tr><th>Status</th><th>Check</th><th>Controls</th><th>Detail</th></tr></thead>
      <tbody>
      {% for r in results %}
        <tr>
         <td>
            <span class="pill {{ r.status }}">{{ r.status }}</span>
            {% if r.exception %}<span class="pill accepted">accepted risk</span>{% endif %}
          </td>
          <td><b>{{ r.check_id }}</b> {{ r.title }}</td>
          <td class="controls">
            {{ r.frameworks.nist_800_53 | join(", ") }}<br>
            {{ r.frameworks.soc2 | join(", ") }}
          </td>
          <td>
            {{ r.detail }}
            {% if r.exception %}
            <div class="exception">{{ r.exception.id }}: {{ r.exception.justification }}<br>Review by {{ r.exception.review_by }}</div>
            {% endif %}
          </td>     
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endfor %}
</main>
</body>
</html>
